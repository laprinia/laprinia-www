# Cloudinary (required for image hosting and uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD=your-cloudinary-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# EmailJS (required for the contact form)
NEXT_PUBLIC_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_KEY=your-emailjs-public-key
